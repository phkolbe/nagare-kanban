# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ---- runtime data ----
# The SQLite database is generated by `python run.py` (which seeds it on first run),
# so it is derived state, not source. Delete it and re-run to get a clean workspace.
data/

# ---- third-party reference screenshots ----
# `tools/fetch_references.py` captures screenshots of other companies' websites to use
# as the opponent side of the blind design comparison. Those images are their copyright,
# not ours, so they are deliberately NOT redistributed here. Regenerate locally with:
#     python tools/fetch_references.py
refs/
# Composites built from those same third-party captures (plus the answer key, which is
# meant to stay hidden from the critic while a round is being judged).
compare/

# ---- generated reports & working crops ----
tools/*_report.json
tools/*_report.txt
shots/_focus/

# ---- editors / OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
