# Nagare Kanban — ambiente. Copie para .env (o ambiente real vence o arquivo).
# So configuracao de ambiente: regra de negocio nao entra aqui.

# Banco: PostgreSQL do compose do pampufa-platform (use 127.0.0.1, nao localhost, no
# Windows). Sem esta linha, um SQLite em data/ serve a demonstracao.
NAGARE_DATABASE_URL=postgresql+asyncpg://nagare:nagare@127.0.0.1:5432/nagare
NAGARE_PORT=8770
NAGARE_DEV=true

# Login local (HS256). Fora da maquina de desenvolvimento, troque por um segredo
# proprio: python -c "import secrets; print(secrets.token_urlsafe(48))"
NAGARE_JWT_SECRET=

# Integracao com a Pampufa (NG1-NG17). Vazio: o Nagare roda sozinho e recusa tokens
# da Pampufa.
NAGARE_PAMPUFA_URL=http://127.0.0.1:8030
NAGARE_PAMPUFA_EMISSOR=pampufa
# Credencial de servico do Nagare na Pampufa (avisa a entrega do cartao). O pampufa
# guarda so o SHA-256 do segredo em SERVICOS_CLIENTES (nagare:<hash>).
NAGARE_PAMPUFA_CLIENTE_ID=nagare
NAGARE_PAMPUFA_CLIENTE_SEGREDO=
NAGARE_WEBHOOK_INTERVALO=5
# Onde as pessoas abrem um cartao (o link que a Pampufa mostra): as telas da plataforma
# (modulo Tarefas, N2) para os produtos; a tela antiga para o Nagare sozinho.
NAGARE_URL_PUBLICA=http://127.0.0.1:8770
NAGARE_URL_TELAS=http://127.0.0.1:8080/grupo-sr

# Observabilidade (plataforma, OBS-I): coletor OpenTelemetry do compose do pampufa-platform
# (profile observabilidade). Vazio: nada e exportado. NAGARE_METRICS_TOKEN e o mesmo
# METRICS_TOKEN do .env do pampufa-platform (o coletor raspa /metrics com ele).
OTEL_EXPORTER_OTLP_ENDPOINT=
# dev | teste | prod. Fora de dev/teste o `migrar` NAO cria as contas de demonstracao
# (a primeira conta vem de `nagare criar-admin`) e o servidor recusa o segredo de dev.
NAGARE_AMBIENTE=dev
# Forca (true) ou desliga (false) a semente de demonstracao; vazio segue o NAGARE_AMBIENTE.
# NAGARE_SEMENTE_DEMO=
NAGARE_METRICS_TOKEN=
